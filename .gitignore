# ── Virtual environments ──────────────────────────────────────
_venv/
.venv/
venv/
env/
ENV/

# ── Python bytecode ───────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo

# ── Data — heavy / generated ──────────────────────────────────
# Models: .gguf files are too large for plain git — auto-downloaded on first run
data/models/*.gguf
data/models/*.bin
# Keep data/models/ folder itself tracked (has auto_download.py)
data/cache/
data/checkpoints/
data/txt/
data/json/
# Tessdata: large trained models — auto-downloaded to data/tessdata/
data/tessdata/
# Books are the user's own library: large and copyrighted. Keep the folder and
# its README tracked, never the PDFs themselves.
data/input/*
!data/input/README.md
!data/input/README.txt
# Quarantined books that failed the quality gate (derived, reproducible)
data/quarantine/
# GUI-managed PDF categories — local user state
data/categories.json

# ── Logs ──────────────────────────────────────────────────────
logs/app.log
logs/*.log

# ── OS junk ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editor / IDE ──────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo

# ── Build artifacts ───────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg

# ── Android / Buildozer ───────────────────────────────────────
.buildozer/
bin/
*.apk
*.aab

# ── Env / secrets ────────────────────────────────────────────
.env
*.env
secrets.json
