#:kivy 2.3.0
#:import dp  kivy.metrics.dp
#:import sp  kivy.metrics.sp

# ══════════════════════════════════════════════════════════════
#  ParseDat_Diary — Material Design UI
#  Deep-purple / amber dark theme, responsive, Android-ready
# ══════════════════════════════════════════════════════════════

<ParseDatMaterialRoot>:
    orientation: 'vertical'
    md_bg_color: [0.05, 0.04, 0.09, 1]

    # ── Top bar ──────────────────────────────────────────────────
    MDTopAppBar:
        type: 'top'
        title: 'ParseDat_Diary'
        subtitle: 'Chat with your books'
        elevation: 6
        md_bg_color: app.theme_cls.primary_color
        specific_text_color: 1, 1, 1, 1
        anchor_title: 'left'
        right_action_items:
            [['help-circle-outline', lambda x: app.root._toast('Ask AI tab → type question → Send'), 'Help']]

    # ── Body: sidebar + screen ────────────────────────────────────
    MDBoxLayout:
        orientation: 'horizontal'
        size_hint_y: 1
        padding: dp(10)
        spacing: dp(10)

        # ── Left sidebar ─────────────────────────────────────────
        MDCard:
            orientation: 'vertical'
            size_hint_x: None
            width: dp(210)
            padding: dp(14), dp(20)
            spacing: dp(10)
            radius: [dp(20)]
            elevation: 8
            md_bg_color: [0.10, 0.08, 0.17, 1]

            canvas.before:
                Color:
                    rgba: 0.45, 0.18, 0.82, 0.18
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(20)]

            MDLabel:
                text: 'ParseDat_Diary'
                font_style: 'H5'
                bold: True
                theme_text_color: 'Custom'
                text_color: 0.76, 0.52, 1, 1
                adaptive_height: True
                halign: 'center'

            MDLabel:
                text: 'Local AI · No Cloud'
                font_style: 'Caption'
                theme_text_color: 'Hint'
                adaptive_height: True
                halign: 'center'

            MDSeparator:
                height: dp(1)
                color: 0.45, 0.18, 0.82, 0.4

            # Navigation buttons
            MDFillRoundFlatIconButton:
                icon: 'bookshelf'
                text: 'Library'
                size_hint_x: 1
                height: dp(48)
                md_bg_color: app.theme_cls.primary_color
                on_release: sm.current = 'library'

            MDFillRoundFlatIconButton:
                icon: 'book-open-page-variant'
                text: 'Read'
                size_hint_x: 1
                height: dp(48)
                md_bg_color: [0.22, 0.14, 0.38, 1]
                on_release: sm.current = 'read'

            MDFillRoundFlatIconButton:
                icon: 'robot'
                text: 'Ask AI'
                size_hint_x: 1
                height: dp(48)
                md_bg_color: [0.22, 0.14, 0.38, 1]
                on_release: sm.current = 'ask'

            MDFillRoundFlatIconButton:
                icon: 'cog'
                text: 'Settings'
                size_hint_x: 1
                height: dp(48)
                md_bg_color: [0.18, 0.12, 0.28, 1]
                on_release:
                    sm.current = 'settings'
                    root.refresh_settings()

            Widget:
                size_hint_y: 1

            MDLabel:
                text: 'FAISS · llama.cpp'
                font_style: 'Overline'
                theme_text_color: 'Hint'
                halign: 'center'
                adaptive_height: True

        # ── Main content area ─────────────────────────────────────
        ScreenManager:
            id: sm
            size_hint_x: 1

            # ════════════════════════════════════════════════════
            #  LIBRARY SCREEN
            # ════════════════════════════════════════════════════
            Screen:
                name: 'library'
                MDBoxLayout:
                    orientation: 'vertical'
                    spacing: dp(14)
                    padding: dp(18)

                    # Title row
                    MDBoxLayout:
                        orientation: 'horizontal'
                        adaptive_height: True
                        spacing: dp(8)

                        MDIcon:
                            icon: 'bookshelf'
                            theme_text_color: 'Custom'
                            text_color: app.theme_cls.accent_color
                            size_hint_x: None
                            width: dp(32)
                            halign: 'center'

                        MDLabel:
                            text: 'Your Library'
                            font_style: 'H5'
                            bold: True
                            theme_text_color: 'Primary'
                            adaptive_height: True

                    MDLabel:
                        text: root.status_library
                        theme_text_color: 'Secondary'
                        adaptive_height: True

                    # Live library state, straight from LibraryService — the
                    # same object `main.py doctor` uses, so this can never
                    # disagree with the CLI.
                    MDCard:
                        size_hint_y: None
                        height: dp(38)
                        padding: dp(10), dp(4)
                        radius: [dp(12)]
                        elevation: 2
                        md_bg_color: [0.10, 0.16, 0.22, 1]
                        MDLabel:
                            text: root.library_info
                            font_style: 'Caption'
                            theme_text_color: 'Secondary'
                            adaptive_height: True

                    # Category filter bar
                    MDCard:
                        size_hint_y: None
                        height: dp(38)
                        padding: dp(10), dp(4)
                        radius: [dp(12)]
                        elevation: 2
                        md_bg_color: [0.14, 0.10, 0.24, 1]
                        MDLabel:
                            text: 'Filter: ' + root.active_category
                            font_style: 'Caption'
                            theme_text_color: 'Secondary'
                            adaptive_height: True

                    # Action buttons row 1
                    MDBoxLayout:
                        orientation: 'horizontal'
                        spacing: dp(10)
                        adaptive_height: True

                        MDFillRoundFlatIconButton:
                            icon: 'file-plus'
                            text: 'Add PDFs'
                            height: dp(48)
                            md_bg_color: app.theme_cls.primary_color
                            on_release: root.on_pick_upload()

                        MDFillRoundFlatIconButton:
                            icon: 'database-sync'
                            text: 'Ingest & Index'
                            height: dp(48)
                            md_bg_color: [0.8, 0.55, 0, 1]
                            theme_text_color: 'Custom'
                            text_color: 0, 0, 0, 1
                            on_release: root.on_run_ingest()

                    # Action buttons row 2
                    MDBoxLayout:
                        orientation: 'horizontal'
                        spacing: dp(10)
                        adaptive_height: True

                        MDFillRoundFlatIconButton:
                            icon: 'filter-variant'
                            text: 'Filter Category'
                            height: dp(44)
                            md_bg_color: [0.22, 0.14, 0.38, 1]
                            on_release: root.show_category_menu(self)

                        MDFillRoundFlatIconButton:
                            icon: 'folder-plus'
                            text: 'New Category'
                            height: dp(44)
                            md_bg_color: [0.22, 0.14, 0.38, 1]
                            on_release: root.on_new_category()

                        MDFillRoundFlatIconButton:
                            icon: 'dots-vertical'
                            text: 'Manage PDFs'
                            height: dp(44)
                            md_bg_color: [0.3, 0.1, 0.1, 1]
                            on_release: root.show_pdf_actions_menu(self)

                        MDFillRoundFlatIconButton:
                            icon: 'refresh'
                            text: 'Refresh'
                            height: dp(44)
                            md_bg_color: [0.14, 0.10, 0.24, 1]
                            on_release: root.refresh_pdf_list()

                    # Progress bar + status
                    MDProgressBar:
                        size_hint_y: None
                        height: dp(6)
                        max: 1
                        value: root.ingest_progress_value
                        color: app.theme_cls.accent_color

                    MDLabel:
                        text: root.ingest_status
                        theme_text_color: 'Hint'
                        font_style: 'Caption'
                        adaptive_height: True

                    # PDF list card
                    MDCard:
                        elevation: 4
                        radius: [dp(16)]
                        padding: dp(14)
                        size_hint_y: 1
                        md_bg_color: [0.10, 0.08, 0.17, 1]

                        ScrollView:
                            bar_width: dp(5)
                            bar_color: app.theme_cls.accent_color

                            MDLabel:
                                text: root.pdf_list_compact
                                theme_text_color: 'Primary'
                                adaptive_height: True
                                size_hint_y: None
                                height: self.texture_size[1]
                                line_height: 1.7
                                font_size: sp(14)

            # ════════════════════════════════════════════════════
            #  READ SCREEN
            # ════════════════════════════════════════════════════
            Screen:
                name: 'read'
                MDBoxLayout:
                    orientation: 'vertical'
                    spacing: dp(12)
                    padding: dp(18)

                    MDBoxLayout:
                        orientation: 'horizontal'
                        adaptive_height: True
                        spacing: dp(8)

                        MDIcon:
                            icon: 'book-open-page-variant'
                            theme_text_color: 'Custom'
                            text_color: app.theme_cls.accent_color
                            size_hint_x: None
                            width: dp(32)
                            halign: 'center'

                        MDLabel:
                            text: 'Read Document'
                            font_style: 'H5'
                            bold: True
                            theme_text_color: 'Primary'
                            adaptive_height: True

                    MDLabel:
                        text: root.status_read_tab
                        theme_text_color: 'Secondary'
                        adaptive_height: True

                    # Document picker
                    MDCard:
                        orientation: 'horizontal'
                        size_hint_y: None
                        height: dp(52)
                        padding: dp(6)
                        radius: [dp(14)]
                        elevation: 3
                        md_bg_color: [0.14, 0.10, 0.24, 1]

                        MDRectangleFlatIconButton:
                            icon: 'file-document-outline'
                            text: root.pdf_chip_hint
                            on_release: root.on_open_pdf_menu(self)
                            size_hint_x: 1
                            theme_text_color: 'Custom'
                            text_color: app.theme_cls.accent_color

                    MDLabel:
                        text: root.preview_heading
                        theme_text_color: 'Hint'
                        font_style: 'Caption'
                        adaptive_height: True

                    # Preview area
                    MDCard:
                        elevation: 5
                        padding: dp(14)
                        radius: [dp(18)]
                        size_hint_y: 1
                        md_bg_color: [0.10, 0.08, 0.17, 1]

                        ScrollView:
                            id: preview_scroll
                            bar_width: dp(5)
                            bar_color: app.theme_cls.accent_color
                            on_width:
                                pdf_preview.text_size = (max(self.width - dp(24), dp(220)), None)

                            MDLabel:
                                id: pdf_preview
                                text: root.preview_display
                                adaptive_height: True
                                text_size: self.width, None
                                size_hint_y: None
                                size_hint_x: 1
                                height: self.texture_size[1]
                                theme_text_color: 'Primary'
                                line_height: 1.6
                                padding: dp(8), dp(8)
                                font_size: sp(14)

            # ════════════════════════════════════════════════════
            #  ASK AI SCREEN
            # ════════════════════════════════════════════════════
            Screen:
                name: 'ask'
                MDBoxLayout:
                    orientation: 'vertical'
                    spacing: dp(12)
                    padding: dp(18)

                    # Header row
                    MDBoxLayout:
                        orientation: 'horizontal'
                        adaptive_height: True
                        spacing: dp(8)

                        MDIcon:
                            icon: 'robot'
                            theme_text_color: 'Custom'
                            text_color: app.theme_cls.accent_color
                            size_hint_x: None
                            width: dp(32)
                            halign: 'center'

                        MDLabel:
                            text: 'Ask Your Books'
                            font_style: 'H5'
                            bold: True
                            theme_text_color: 'Primary'
                            adaptive_height: True

                    # Status chip
                    MDCard:
                        size_hint_y: None
                        height: dp(38)
                        padding: dp(10), dp(6)
                        radius: [dp(12)]
                        elevation: 2
                        md_bg_color: [0.14, 0.10, 0.24, 1]

                        MDLabel:
                            text: root.rag_status_hint
                            theme_text_color: 'Secondary'
                            font_style: 'Caption'
                            adaptive_height: True

                    # Question input
                    MDCard:
                        padding: dp(6)
                        radius: [dp(14)]
                        elevation: 3
                        size_hint_y: None
                        height: dp(130)
                        md_bg_color: [0.14, 0.10, 0.24, 1]

                        MDTextField:
                            id: question_field
                            hint_text: 'Type your question about the indexed PDFs…'
                            multiline: True
                            mode: 'fill'
                            fill_color_normal: 0, 0, 0, 0
                            fill_color_focus: 0, 0, 0, 0
                            line_color_normal: app.theme_cls.accent_color
                            line_color_focus: app.theme_cls.primary_color
                            size_hint_y: None
                            height: dp(118)

                    # Send button
                    MDBoxLayout:
                        adaptive_height: True
                        spacing: dp(10)
                        pos_hint: {'center_x': 0.5}
                        size_hint_x: None
                        width: dp(470)

                        MDFillRoundFlatIconButton:
                            icon: 'send'
                            text: 'Send'
                            size_hint_x: None
                            width: dp(180)
                            height: dp(52)
                            md_bg_color: app.theme_cls.accent_color
                            theme_text_color: 'Custom'
                            text_color: 0, 0, 0, 1
                            elevation: 4
                            on_release: root.on_ask()

                        MDRoundFlatIconButton:
                            icon: 'plus-circle-outline'
                            text: 'New chat'
                            size_hint_x: None
                            width: dp(140)
                            height: dp(52)
                            on_release: root.on_new_chat()

                        MDRoundFlatIconButton:
                            icon: 'history'
                            text: 'History'
                            size_hint_x: None
                            width: dp(130)
                            height: dp(52)
                            on_release: root.on_show_history()

                    # Answer card
                    MDCard:
                        elevation: 5
                        padding: dp(16)
                        radius: [dp(18)]
                        size_hint_y: 1
                        md_bg_color: [0.10, 0.08, 0.17, 1]

                        canvas.before:
                            Color:
                                rgba: 0.45, 0.18, 0.82, 0.08
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [dp(18)]

                        ScrollView:
                            id: ans_scroll
                            bar_width: dp(5)
                            bar_color: app.theme_cls.accent_color
                            on_width:
                                answer_area.text_size = (max(self.width - dp(24), dp(220)), None)

                            MDLabel:
                                id: answer_area
                                text: root.answer_display
                                adaptive_height: True
                                text_size: self.width, None
                                size_hint_y: None
                                size_hint_x: 1
                                height: self.texture_size[1]
                                theme_text_color: 'Primary'
                                line_height: 1.65
                                padding: dp(10), dp(10)
                                font_size: sp(15)

            # ════════════════════════════════════════════════════
            #  SETTINGS SCREEN — Model & Embedder switcher
            # ════════════════════════════════════════════════════
            Screen:
                name: 'settings'
                MDScrollView:
                    # The whole screen scrolls, not just the form list below --
                    # a scrollview nested inside a fixed-height card was the bug:
                    # the outer screen had nothing to scroll IT, so the page
                    # looked cut off with three cards fighting for fixed space.
                    bar_width: dp(6)
                    bar_color: app.theme_cls.accent_color
                    scroll_type: ['bars', 'content']

                    MDBoxLayout:
                        orientation: 'vertical'
                        spacing: dp(14)
                        padding: dp(18)
                        adaptive_height: True
                        size_hint_y: None
                        height: self.minimum_height

                        MDBoxLayout:
                            orientation: 'horizontal'
                            adaptive_height: True
                            spacing: dp(8)
                            MDIcon:
                                icon: 'cog'
                                theme_text_color: 'Custom'
                                text_color: app.theme_cls.accent_color
                                size_hint_x: None
                                width: dp(32)
                                halign: 'center'
                            MDLabel:
                                text: 'Settings'
                                font_style: 'H5'
                                bold: True
                                theme_text_color: 'Primary'
                                adaptive_height: True

                        # ── LLM Model section ──────────────────────
                        MDCard:
                            orientation: 'vertical'
                            padding: dp(14)
                            spacing: dp(8)
                            radius: [dp(16)]
                            elevation: 4
                            md_bg_color: [0.10, 0.08, 0.17, 1]
                            size_hint_y: None
                            height: self.minimum_height

                            MDLabel:
                                text: 'LLM Model (GGUF)'
                                font_style: 'Subtitle1'
                                bold: True
                                theme_text_color: 'Custom'
                                text_color: app.theme_cls.accent_color
                                adaptive_height: True

                            MDLabel:
                                text: 'Active: ' + root.active_model_label
                                theme_text_color: 'Secondary'
                                font_style: 'Caption'
                                adaptive_height: True

                            MDFillRoundFlatIconButton:
                                icon: 'swap-horizontal'
                                text: 'Switch / Download Model'
                                size_hint_x: 1
                                height: dp(48)
                                md_bg_color: app.theme_cls.primary_color
                                on_release: root.show_model_menu(self)

                            MDLabel:
                                text: root.dl_status
                                theme_text_color: 'Hint'
                                font_style: 'Caption'
                                adaptive_height: True

                            MDLabel:
                                text: 'Local models:\n' + root.model_list_text
                                theme_text_color: 'Primary'
                                font_style: 'Caption'
                                adaptive_height: True
                                size_hint_y: None
                                height: self.texture_size[1]

                        # ── Embedder section ───────────────────────
                        MDCard:
                            orientation: 'vertical'
                            padding: dp(14)
                            spacing: dp(8)
                            radius: [dp(16)]
                            elevation: 4
                            md_bg_color: [0.10, 0.08, 0.17, 1]
                            size_hint_y: None
                            height: self.minimum_height

                            MDLabel:
                                text: 'Embedding Model'
                                font_style: 'Subtitle1'
                                bold: True
                                theme_text_color: 'Custom'
                                text_color: app.theme_cls.accent_color
                                adaptive_height: True

                            MDLabel:
                                text: 'Active: ' + root.active_embedder_label
                                theme_text_color: 'Secondary'
                                font_style: 'Caption'
                                adaptive_height: True

                            MDFillRoundFlatIconButton:
                                icon: 'lightning-bolt'
                                text: 'Switch Embedder (no API)'
                                size_hint_x: 1
                                height: dp(48)
                                md_bg_color: [0.8, 0.55, 0, 1]
                                theme_text_color: 'Custom'
                                text_color: 0, 0, 0, 1
                                on_release: root.show_embedder_menu(self)

                            MDLabel:
                                text: 'All embedders run locally — no internet / API key required.\nRe-ingest after switching.'
                                theme_text_color: 'Hint'
                                font_style: 'Caption'
                                adaptive_height: True

                        # ── All Settings — schema-driven form ──────
                        MDCard:
                            orientation: 'vertical'
                            padding: dp(14)
                            spacing: dp(8)
                            radius: [dp(16)]
                            elevation: 4
                            md_bg_color: [0.10, 0.08, 0.17, 1]
                            size_hint_y: None
                            height: self.minimum_height

                            MDBoxLayout:
                                orientation: 'horizontal'
                                adaptive_height: True
                                spacing: dp(8)

                                MDLabel:
                                    text: 'All Settings'
                                    font_style: 'Subtitle1'
                                    bold: True
                                    theme_text_color: 'Custom'
                                    text_color: app.theme_cls.accent_color
                                    adaptive_height: True

                                MDFillRoundFlatIconButton:
                                    icon: 'content-save'
                                    text: 'Save Settings'
                                    size_hint_x: None
                                    width: dp(180)
                                    height: dp(40)
                                    md_bg_color: app.theme_cls.primary_color
                                    on_release: root.on_save_all_settings()

                            MDLabel:
                                text: root.settings_save_status or 'Every field below reads config/config.py\'s defaults, layered with anything saved here. Changes write to data/settings.json — delete that file to reset everything.'
                                theme_text_color: 'Hint'
                                font_style: 'Caption'
                                adaptive_height: True
                                text_size: self.width, None

                            MDBoxLayout:
                                id: settings_form_box
                                orientation: 'vertical'
                                spacing: dp(6)
                                adaptive_height: True
                                size_hint_y: None
                                height: self.minimum_height
